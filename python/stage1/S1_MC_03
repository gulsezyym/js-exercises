def calc(a, op, b):
    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):
        return None

    match op:
        case "+": return a + b
        case "-": return a - b
        case "*": return a * b
        case "/":
            return None if b == 0 else a / b
        case _: return None


tests = [
    (10, "+", 5),
    (10, "/", 2),
    (10, "/", 0),
    (10, "x", 3),
]

for t in tests:
    print(t, "->", calc(*t))
